# ============================================
# Railway Production Environment Variables
# ============================================
# Copy this file and set values in Railway Dashboard

# ============================================
# Database (Railway PostgreSQL)
# ============================================
# DATABASE_URL is automatically set by Railway when you add PostgreSQL

# ============================================
# RabbitMQ (Self-hosted on Railway)
# ============================================
# For self-hosted RabbitMQ on Railway private network:
RABBITMQ_URL=amqp://admin:admin@rabbitmq.railway.internal:5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin

# ============================================
# JWT Configuration (REQUIRED - generate strong secret)
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=<generate-strong-64-char-secret>
JWT_EXPIRATION=7d

# ============================================
# Node Environment
# ============================================
NODE_ENV=production

# ============================================
# Auth Service Variables
# ============================================
PORT=3001
CORS_ORIGINS=https://your-web-app.up.railway.app,https://your-admin-app.up.railway.app,https://your-technician-app.up.railway.app

# ============================================
# Orders Service Variables
# ============================================
PORT=3003
AUTH_SERVICE_URL=http://auth.railway.internal:3001

# ============================================
# Services Service Variables
# ============================================
PORT=3005

# ============================================
# Payment Service Variables (Django)
# ============================================
PORT=3004
DJANGO_SECRET_KEY=<generate-strong-django-secret>
DEBUG=False
ALLOWED_HOSTS=.railway.app,payment.railway.internal

# SSLCommerz Production Credentials
SSLCOMMERZ_STORE_ID=<your-production-store-id>
SSLCOMMERZ_STORE_PASSWORD=<your-production-password>
SSLCOMMERZ_ENVIRONMENT=live

# Payment callback URLs
PAYMENT_BASE_URL=https://your-payment-service.up.railway.app
WEB_APP_BASE_URL=https://your-web-app.up.railway.app

# ============================================
# Notifications Service Variables
# ============================================
PORT=3002

# ============================================
# Railway Private Networking
# ============================================
# These are automatically set by Railway:
# RAILWAY_PRIVATE_DOMAIN=<service>.railway.internal
# RAILWAY_PUBLIC_DOMAIN=<service>.up.railway.app
# RAILWAY_ENVIRONMENT=production

# ============================================
# Inter-Service Communication URLs (Railway Private Network)
# ============================================
AUTH_SERVICE_URL=http://auth.railway.internal:3001
ORDERS_SERVICE_URL=http://orders.railway.internal:3003
SERVICES_SERVICE_URL=http://services.railway.internal:3005
PAYMENT_SERVICE_URL=http://payment.railway.internal:3004
NOTIFICATIONS_SERVICE_URL=http://notifications.railway.internal:3002
