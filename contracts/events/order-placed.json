{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local-services.com/schemas/events/order-placed.json",
  "title": "OrderPlacedEvent",
  "description": "Event emitted when a new order is placed",
  "type": "object",
  "required": ["eventType", "timestamp", "correlationId", "payload"],
  "properties": {
    "eventType": {
      "const": "order.placed"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "required": ["orderId", "userId", "totalAmount"],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "format": "uuid"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["serviceId", "quantity", "price"],
            "properties": {
              "serviceId": {
                "type": "string",
                "format": "uuid"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "price": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "totalAmount": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
