# Database
DATABASE_URL=postgresql://localservices:localservices@localhost:5432/localservices
POSTGRES_USER=localservices
POSTGRES_PASSWORD=localservices
POSTGRES_DB=localservices

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin@localhost:5672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Services URLs (for local development without Docker)
AUTH_SERVICE_URL=http://localhost:3001
NOTIFICATIONS_SERVICE_URL=http://localhost:3002
ORDERS_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3010
NEXT_PUBLIC_TECHNICIAN_URL=http://localhost:3020
