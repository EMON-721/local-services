generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String      @id @default(uuid())
  bookingId       String      @unique @map("booking_id")
  userId          String      @map("user_id")
  technicianId    String?     @map("technician_id")
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  baseAmount      Decimal     @map("base_amount") @db.Decimal(10, 2)
  tier            ServiceTier @default(STANDARD)
  tierMultiplier  Decimal     @map("tier_multiplier") @db.Decimal(3, 2) @default(1.0)
  areaSize        String?     @map("area_size")
  scheduledDate   DateTime?   @map("scheduled_date")
  scheduledTime   String?     @map("scheduled_time")
  completedDate   DateTime?   @map("completed_date")
  assignedAt      DateTime?   @map("assigned_at")
  startedAt       DateTime?   @map("started_at")
  notes           String?
  additionalInfo  String?     @map("additional_info")
  rating          Int?
  review          String?
  paymentMethod   PaymentMethod  @default(COD) @map("payment_method")
  paymentStatus   PaymentStatus  @default(PENDING) @map("payment_status")
  paymentId       String?        @map("payment_id")
  paymentSessionId String?       @map("payment_session_id")
  paidAt          DateTime?      @map("paid_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  items    OrderItem[]
  address  OrderAddress?
  history  OrderHistory[]

  @@index([userId])
  @@index([technicianId])
  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  serviceId   String  @map("service_id")
  serviceName String  @map("service_name")
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model OrderAddress {
  id         String @id @default(uuid())
  orderId    String @unique @map("order_id")
  area       String
  city       String
  division   String
  postalCode String @map("postal_code")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderHistory {
  id            String       @id @default(uuid())
  orderId       String       @map("order_id")
  fromStatus    OrderStatus? @map("from_status")
  toStatus      OrderStatus  @map("to_status")
  changedBy     String       @map("changed_by")
  changedByRole String       @map("changed_by_role")
  reason        String?
  createdAt     DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_history")
}

model TechnicianProfile {
  id              String   @id
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  phone           String?
  avatar          String?
  rating          Decimal  @default(0) @db.Decimal(2, 1)
  totalJobs       Int      @default(0) @map("total_jobs")
  completedJobs   Int      @default(0) @map("completed_jobs")
  isAvailable     Boolean  @default(true) @map("is_available")
  serviceAreas    String[] @map("service_areas")
  specializations String[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  availability TechnicianAvailability[]

  @@map("technician_profiles")
}

model TechnicianAvailability {
  id           String  @id @default(uuid())
  technicianId String  @map("technician_id")
  dayOfWeek    Int     @map("day_of_week")
  startTime    String  @map("start_time")
  endTime      String  @map("end_time")
  isAvailable  Boolean @default(true) @map("is_available")

  technician TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([technicianId, dayOfWeek])
  @@map("technician_availability")
}

model Service {
  id          String   @id @default(uuid())
  categoryId  String   @map("category_id")
  name        String
  slug        String
  description String?
  icon        String?
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  duration    Int
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, slug])
  @@map("services")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceTier {
  STANDARD
  PREMIUM
  DELUXE
}

enum PaymentMethod {
  ONLINE
  COD
}

enum PaymentStatus {
  PENDING
  INITIATED
  COMPLETED
  FAILED
  REFUNDED
}
